# Copia in .env e adatta. Il file .env NON va versionato.
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200

# Connessione PostgreSQL (in alternativa imposta DATABASE_URL, es. su Render)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=archivio00_angular
DB_SSL=false
# DATABASE_URL=postgres://utente:password@host:5432/archivio00_angular

# Almeno 32 caratteri. Generane uno con: openssl rand -hex 32
JWT_SECRET=change-me-with-a-long-random-string-0123456789
JWT_EXPIRES_IN=24h

# Account dimostrativi (utente@archivio00.it / javier@archivio00.it). Metti false in produzione.
SEED_DEMO_USERS=true

# Richieste al minuto per IP su login/registrazione (default 30)
# AUTH_RATE_LIMIT=30
# Proxy fidati davanti all'API (su Render metti 1), serve a leggere l'IP vero del client
# TRUST_PROXY=0
